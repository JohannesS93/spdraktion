-- Users importieren
INSERT INTO users (id, email, first_name, last_name, group_id, role)
VALUESpython3 - << 'EOF'
import csv
import uuid
group_map = {
    "A": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
    "B": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb",
    "C": "cccccccc-cccc-cccc-cccc-cccccccccccc",
}

def bundestag_email(vor, nach):
    local = f"{vor.lower()}.{nach.lower()}"
    for token in ("prof.", "dr.", "jur.", "(med)"):
        local = local.replace(token, "")
    local = local.replace("..", ".").replace(" ", "")
    return f"{local}@bundestag.de"

rows = []
with open("/mnt/data/Personen-Gruppen_neu3.csv", encoding="latin1") as f:
    reader = csv.reader(f, delimiter=';')
    next(reader)
    for r in reader:
        vor, nach, grp, role = r
        email = bundestag_email(vor, nach)
        rows.append(
            f"('{uuid.uuid4()}', '{email}', '{vor}', '{nach}', '{group_map.get(grp)}', '{role}')"
        )

print(",\n".join(rows) + ";")
EOFpython3 - << 'EOF'
import csv
import uuid

group_map = {
    "A": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
    "B": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb",
    "C": "cccccccc-cccc-cccc-cccc-cccccccccccc",
}

rows = []
with open("/mnt/data/Personen-Gruppen_neu3.csv", encoding="latin1") as f:
    reader = csv.reader(f, delimiter=';')
    next(reader)
    for r in reader:
        vor, nach, grp, role = r
        email = bundestag_email(vor, nach)
        rows.append(
            f"('{uuid.uuid4()}', '{email}', '{vor}', '{nach}', '{group_map.get(grp)}', '{role}')"
        )

print(",\n".join(rows) + ";")
EOF
